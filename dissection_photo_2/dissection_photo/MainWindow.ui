                 <item>
                  <widget class="QPushButton" name="pushButtonUploadImages">
                   <!-- 285 shared with pushButtonUploadCalibration and pushButtonUploadPhoto so all
                        upload pills are the same size. A floor sized for the widest fallback font
                        (" Upload Calibration" bold 19px is 204px in Verdana): 204 + 32 icon + 4 gap +
                        40 padding + 2 border = 282. -->
                   <property name="minimumSize">
                    <size>
                     <width>285</width>
                     <height>0</height>
                    </size>
                   </property>
                   <property name="cursor">
                    <cursorShape>PointingHandCursor</cursorShape>
                   </property>
                   <property name="styleSheet">
                    <!-- A declared transparent border is required: with "border: none" Fusion
                         doesn't clip the fill to border-radius, so corners go square. Hover/pressed
                         darken like the other buttons (#4c8da7/#427a91). Each state repeats border
                         and radius. -->
                    <string notr="true">QPushButton {padding: 10 24 10 24; font-weight: bold; font-size: 14px; background: #57a2c0; border: 1px solid transparent; border-radius: 22; color:white;}
QPushButton:hover {background: #4c8da7; border: 1px solid transparent; border-radius: 22; color:white;}
QPushButton:pressed {background: #427a91; border: 1px solid transparent; border-radius: 22; color:white;}
QPushButton:disabled {background: #999999; border: 1px solid transparent; border-radius: 22; color:white;}</string>
                   </property>
