            <item>
             <!-- Shortcut reference as a two-column table (action, hotkey): Qt rich text only
                  column-aligns tables. 14px so it draws less focus than the instruction.
                  No wordWrap: columns size to content and white-space:pre keeps chords on
                  one line. Box colours are set per theme in SetDarkMode(); only font-size
                  lives here (rich-text reason as on label_10). -->
             <widget class="QLabel" name="labelSegHotkeys">
              <property name="styleSheet">
               <string notr="true">font-size: 14px;</string>
              </property>
