#!/usr/bin/env bash
[ ! -e "$FREESURFER_HOME" ] && echo "error: freesurfer has not been properly sourced" && exit 1

if [[ ! -v RUN_FSDEEPNET ]]; then
    echo "Running Freesurfer version of @SCRIPTNAME@ ..."
    echo "$FREESURFER_HOME/bin/fspython $FREESURFER_HOME/python/scripts/@SCRIPTNAME@ $@"
    echo
    exec $FREESURFER_HOME/bin/fspython $FREESURFER_HOME/python/scripts/@SCRIPTNAME@ "$@"
else
    # ??? set PYTHON_VER in recon-all or during the install phase ???
    PYTHON_VER=`$FREESURFER_HOME/bin/fspython --version | awk '{print $2}' | cut -d'.' -f1,2`
    echo "Running FSdeepnet version of @SCRIPTNAME@ ..."
    echo "$FREESURFER_HOME/bin/fspython $FREESURFER_HOME/python/lib/python$PYTHON_VER/site-packages/fsdeepnet/apps/@SCRIPTNAME@/cli/@SCRIPTNAME@.py $@"
    echo
    exec $FREESURFER_HOME/bin/fspython $FREESURFER_HOME/python/lib/python$PYTHON_VER/site-packages/fsdeepnet/apps/@SCRIPTNAME@/cli/@SCRIPTNAME@.py "$@"
fi
